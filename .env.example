# ==============================================================================
# SkillHub Elite - Production Environment Variables Template (.env.example)
# Copy this file to .env and supply actual values in your secure environment.
# NEVER commit the filled .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 2. Production Database (MySQL 8.0)
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://skillhub-mysql:3306/skillhub?useSSL=true&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true&connectionCollation=utf8mb4_unicode_ci
DB_USERNAME=skillhub_user
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
MYSQL_ROOT_PASSWORD=YOUR_SECURE_MYSQL_ROOT_PASSWORD_HERE
MYSQL_DATABASE=skillhub

# HikariCP Connection Pool Tuning (Optional overrides)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_CONNECTION_TIMEOUT=20000
DB_POOL_MAX_LIFETIME=1200000

# ------------------------------------------------------------------------------
# 3. SMTP Mail Service
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-org-notifications@yourdomain.com
MAIL_PASSWORD=YOUR_APP_SPECIFIC_MAIL_PASSWORD_HERE

# ------------------------------------------------------------------------------
# 4. Razorpay Payment Gateway (Live or Test Keys)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE

# ------------------------------------------------------------------------------
# 5. JWT Authentication Security
# ------------------------------------------------------------------------------
# Must be at least 256 bits (32 bytes) Base64-encoded secret
JWT_SECRET=YOUR_BASE64_ENCODED_256BIT_SECRET_KEY_HERE
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 6. External Coding Execution Sandbox
# ------------------------------------------------------------------------------
CODE_EXECUTION_MODE=production
CODING_RUNNER_URL=https://isolated-runner.internal.skillhub.com/api/execute
CODING_RUNNER_SECRET=YOUR_RUNNER_SHARED_BEARER_SECRET_HERE

# ------------------------------------------------------------------------------
# 7. Google Gemini AI API Key
# ------------------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ------------------------------------------------------------------------------
# 8. File Storage Path
# ------------------------------------------------------------------------------
UPLOAD_DIR=/var/skillhub/uploads
